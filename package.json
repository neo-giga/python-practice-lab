{
  "name": "python-interview-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Learn Python 3 interview idioms: cheatsheet, graded drills and a real CPython (Pyodide) playground in the browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "copy-pyodide": "node scripts/copy-pyodide.mjs",
    "predev": "npm run copy-pyodide",
    "dev": "vite",
    "prebuild": "npm run copy-pyodide",
    "build": "vite build",
    "preview": "node scripts/serve-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cheatsheet": "vite-node scripts/generate-cheatsheet.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:corpus": "vitest run --project corpus",
    "test:portability": "vite-node scripts/export-content.ts && uv run --no-project --python 3.11 python scripts/portability.py build/content.json",
    "gate": "vite-node scripts/gate-content.ts --",
    "catalog": "vite-node scripts/catalog-report.ts --",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@lezer/python": "1.1.19",
    "codemirror": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "pyodide": "314.0.7",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-node": "6.0.0",
    "vitest": "5.0.5"
  }
}
